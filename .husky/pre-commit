# Formatar com Laravel Pint, somente os arquivos que estam no commit.
STAGED_FILES=$(git diff --cached --name-only --diff-filter=ACM | grep ".php\{0,1\}$") || true

for FILE in $STAGED_FILES
do
    # Dessa forma exibe o que foi corrigido na formatação.
    ./vendor/bin/pint "${FILE}"; 

    # Dessa forma não exibe.
    #./vendor/bin/pint "${FILE}" > /dev/null >&1;

    git add "${FILE}";
done;

exit 0;